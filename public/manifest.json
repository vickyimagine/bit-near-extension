{
  "manifest_version": 2,
  "name": "Bitwallet",
  "version": "4.9.7",
  "permissions": ["activeTab", "storage", "tabs", "webNavigation", "<all_urls>"],
  "background": {
    "scripts": ["background.js"],
    "persistent": false,
    "type": "module"
  },
  "browser_action": {
    "default_popup": "index.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content-script.js"],
      "all_frames": true,
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    "browser-polyfill.js",
    "inject-script.js",
    "connection-popup.html",
    "connection-popup.js",
    "password-popup.html",
    "password-popup.js"
  ],
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "browser_specific_settings": {"gecko": {"id": "{7b6e9002-6552-4f8b-bb5a-0f197bad7a96}"}}
}
